{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client", "webmcp-types"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /*
     * `libReplacement` lets TypeScript swap its built-in `lib.dom.d.ts` for the
     * one installed under the `@typescript/lib-dom` alias. This project aliases
     * that to `modern-web-types`, which is generated by the same pipeline as
     * TypeScript's official DOM types but with a one-engine shipping threshold
     * instead of two. That is what gives us spec-accurate `LanguageModel`,
     * `Translator`, `CreateMonitor`, `Navigation`, and `Element.moveBefore`
     * types without hand-writing them.
     *
     * @see https://philipwalton.com/articles/modern-web-types/
     */
    "libReplacement": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
